# Frontend runtime
NEXT_PUBLIC_APP_NAME=CoursePilot
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Auth/session
AUTH_SECRET=


# LLM provider (grounded generation)
GEMINI_API_KEY=
RAG_LLM_MODEL=gemini-3.8-flash

# Python executable for RAG ingest/retrieval bridge
# Windows example: .venv\\Scripts\\python.exe
# macOS/Linux example: .venv/bin/python
RAG_PYTHON_BIN=python
