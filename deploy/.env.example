# Copy to deploy/.env on the server. Never commit the real file.

# Public address of the site, without https://
SITE_ADDRESS=

# Generate with: openssl rand -base64 32
AUTH_SECRET=

GEMINI_API_KEY=
RAG_LLM_MODEL=gemini-3.8-flash

NEXT_PUBLIC_APP_NAME=CoursePilot

# Local port the app listens on. Change it if 3100 is taken.
APP_PORT=3100
